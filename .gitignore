__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
dist/
build/
.env
.env.*

# Live Privy credentials and session material — NEVER commit these.
# .privy_state.json holds the rotating refresh_token + pat; the .consumer_key
# file next to it is a bearer token for this API; the storage dump is the raw
# browser capture that seeded them.
.privy_state.json
.privy_state.json.*
*.consumer_key
privy_storage_dump.json
privy_refresh_call.json
captured_endpoints.json

# Blockchain provider keys (Helius/NodeReal/GoldRush): plaintext read from disk
# on every call, never printed or logged, never committed.
recorder/chain_keys.json
chain_keys.json
# The dashboard writes it via atomic replacement through a temp file in the same
# folder (key_file.save_entries); an interruption mid-write may leave one of
# these behind holding the complete keys.
.keys-*.tmp
recorder/.keys-*.tmp

# Runtime artefacts
evm_replay_run.err
evm_replay_run.out
*.log
# Rotated logs (server.log.1) — not matched by *.log
*.log.*
*.db
*.db-shm
*.db-wal
*.db.bak*
*.db-shm.bak*
*.db-wal.bak*
*.bak-pre-*
*_before.json
backups/
test_output.txt
lint_output.txt
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
playwright/.cache/

# Probe droppings: temp data files emptied out by probe_*.py during inspection
recorder/probe_*.json
recorder/probe_*.out
recorder/probe_*.pkl
